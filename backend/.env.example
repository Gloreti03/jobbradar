# Copy this file to .env and fill in the values. .env must NEVER be committed to GitHub.

# --- DeepSeek API (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_SMART=deepseek-v4-pro
MODEL_FAST=deepseek-flash

# --- ElevenLabs (voice, bonus) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Database ---
DATABASE_URL=sqlite:///./radar.db

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:8080
