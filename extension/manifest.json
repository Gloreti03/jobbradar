{
  "manifest_version": 3,
  "name": "RADAR – Save job",
  "version": "0.1.0",
  "description": "Save the job ad on this page to RADAR and open it in the app.",
  "action": {
    "default_title": "Save this job to RADAR",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"]
}
