# Copia questo file in .env e riempi i valori. .env NON va mai su GitHub.

# --- DeepSeek API (compatibile OpenAI) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_SMART=deepseek-v4-pro
MODEL_FAST=deepseek-flash

# --- ElevenLabs (voce, bonus) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Database ---
DATABASE_URL=sqlite:///./radar.db

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
